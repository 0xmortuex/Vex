    {
      "type": "snippets",
      "id": "portal-recipes",
      "name": "Student portal recipes (verify on the portal)",
      "entries": [
        {
          "label": "e-Devlet: student certificate",
          "text": "Open https://www.turkiye.gov.tr/ and sign in. Search for \"Öğrenci Belgesi\", choose your university, and download the PDF (it has a verification barcode). Menu and service names change: verify on the portal. Last checked 2026-10-17."
        },
        {
          "label": "ÖSYM: sign in to your candidate account",
          "text": "Open https://ais.osym.gov.tr/ from your own bookmark, never from a link in a message. Sign in with the details you set there; applications, the exam entry document and results sit under your account. Menu names change each season: verify on the portal. Last checked 2026-10-17."
        },
        {
          "label": "Apply for a student discount",
          "text": "Open the company's own student page. Sign in with your school email if it asks. Proof usually goes through UNiDAYS, SheerID or your school address; keep your student certificate PDF ready. Most offers must be renewed each year. Terms change: verify on the company's page. Last checked 2026-10-17."
        },
        {
          "label": "University portal: password reset",
          "text": "Use the portal's own \"forgot password\" link; the reset goes to the email on your account. Open the portal from your own bookmark, never from a message, and do not type your university password on a page you reached from one. Steps differ per university: verify on yours. Last checked 2026-10-17."
        }
      ]
    }
  ],
