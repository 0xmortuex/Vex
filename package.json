{
  "name": "vex",
  "version": "41.59.4",
  "description": "Vex — a browser built just for you",
  "author": {
    "name": "0xmortuex",
    "email": "fraad002@gmail.com"
  },
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pretest": "node scripts/heavy-gate.js test",
    "test": "vitest run",
    "smoke": "node scripts/verify-smoke-boot.js",
    "smoke:restart": "node scripts/verify-restart.js",
    "smoke:matrix": "node scripts/check-smoke-matrix.js",
    "smoke:matrix:ci": "node scripts/check-smoke-matrix.js --looks=firefox --tiers=full,simple,minimal --cycles=2 --limit=40",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "pack": "node scripts/heavy-gate.js pack && electron-builder --dir",
    "build-icons": "node scripts/build-icons.js",
    "dist": "node scripts/heavy-gate.js dist && npm run build-icons && node scripts/check-dist-free.js && rimraf dist && electron-builder",
    "dist:win": "node scripts/heavy-gate.js dist:win && npm run build-icons && node scripts/check-dist-free.js && rimraf dist && electron-builder --win",
    "publish": "node scripts/heavy-gate.js publish && npm run build-icons && node scripts/write-release-notes.js && node scripts/check-dist-free.js && rimraf dist && electron-builder --publish never && node scripts/verify-packaged-boot.js && node scripts/verify-drm.js --boot && node scripts/verify-signing.js --release && node scripts/ensure-release.js && node scripts/upload-release.js",
    "check:source": "node scripts/verify-source.js",
    "check:a11y": "node scripts/check-a11y-gate.js",
    "check:looks": "node scripts/heavy-gate.js check:looks && node scripts/check-look-matrix.js",
    "check:ui": "node scripts/heavy-gate.js check:ui && node scripts/check-ui.js",
    "perf": "node scripts/perf-baseline.js",
    "build:vendor": "node scripts/bundle-browser-libs.js",
    "prestart": "npm run build:vendor",
    "prepack": "npm run build:vendor",
    "predist": "npm run build:vendor",
    "predist:win": "npm run build:vendor",
    "prepublish": "npm run build:vendor",
    "postpublish": "node scripts/post-publish.js",
    "check:types": "tsc -p jsconfig.contracts.json && tsc -p jsconfig.sync.json",
    "lint": "eslint src/main src/main.js scripts/build-icons.js scripts/bundle-browser-libs.js src/diagnostics.js src/renderer/js/network.js src/renderer/js/data-contracts.js src/renderer/js/sync-records.js src/renderer/js/lifecycle.js scripts/verify-source.js src/renderer/js/collection-store.js src/renderer/js/i18n.js src/renderer/js/page-chrome.js src/renderer/js/download-quicklook.js src/renderer/image-viewer src/renderer/js/image-viewer-host.js src/renderer/media-viewer src/renderer/js/media-viewer-host.js src/renderer/js/card-saver.js src/renderer/js/ext-debug-bar.js src/renderer/js/ext-sidepanel.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "^4.3.0",
    "@mlc-ai/web-llm": "^0.2.84",
    "@types/node": "^26.4.1",
    "@vitest/ui": "^4.1.11",
    "electron": "github:castlabs/electron-releases#v42.11.18+wvcus",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-promise": "^7.3.0",
    "fflate": "0.8.3",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "6.4.299",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.0",
    "@pdf-lib/fontkit": "1.1.1",
    "adm-zip": "^0.6.1",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "pdf-lib": "1.17.1",
    "qrcode": "^1.5.4",
    "tar": "^7.5.22"
  },
  "build": {
    "appId": "com.vex.browser",
    "productName": "Vex",
    "copyright": "Copyright 2026 0xmortuex",
    "extends": "./scripts/code-signing.js",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "afterSign": "scripts/vmp-sign.js",
    "beforePack": "scripts/window-bundle.js",
    "electronDownload": {
      "version": "42.11.18+wvcus",
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "!src/renderer/index.html",
      {
        "from": "build/window-bundle/src",
        "to": "src",
        "filter": [
          "**/*"
        ]
      },
      "CHANGELOG.md",
      "CHANGELOG.tr.md",
      "LICENSE",
      "PRIVACY.md",
      "TERMS.md",
      "THIRD_PARTY_NOTICES.md",
      "assets/icon.svg",
      "assets/icon.ico",
      "assets/theme-previews/*.png",
      "package.json",
      "!node_modules/sharp/**",
      "!node_modules/@img/**",
      "!node_modules/onnxruntime-node/**"
    ],
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Document",
        "description": "HTML Document",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTML Document",
        "description": "HTML Document",
        "role": "Viewer"
      }
    ],
    "protocols": [
      {
        "name": "Web URL",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Vex-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vex",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "0xmortuex",
        "repo": "Vex",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "build/release-notes.md"
    }
  }
}
