{
  "name": "vex",
  "version": "2.31.62",
  "description": "Vex — a browser built just for you",
  "author": {
    "name": "0xmortuex",
    "email": "fraad002@gmail.com"
  },
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "smoke": "node scripts/verify-smoke-boot.js",
    "smoke:restart": "node scripts/verify-restart.js",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "pack": "electron-builder --dir",
    "build-icons": "node scripts/build-icons.js",
    "dist": "npm run build-icons && rimraf dist && electron-builder",
    "dist:win": "npm run build-icons && rimraf dist && electron-builder --win",
    "publish": "npm run build-icons && node scripts/write-release-notes.js && rimraf dist && electron-builder --publish always",
    "check:source": "node scripts/verify-source.js",
    "check:ui": "node scripts/check-ui.js",
    "build:vendor": "node scripts/bundle-browser-libs.js",
    "prestart": "npm run build:vendor",
    "prepack": "npm run build:vendor",
    "predist": "npm run build:vendor",
    "predist:win": "npm run build:vendor",
    "prepublish": "npm run build:vendor",
    "check:types": "tsc -p jsconfig.contracts.json && tsc -p jsconfig.sync.json",
    "lint": "eslint src/main src/main.js scripts/build-icons.js scripts/bundle-browser-libs.js src/diagnostics.js src/renderer/js/network.js src/renderer/js/data-contracts.js src/renderer/js/sync-records.js src/renderer/js/lifecycle.js scripts/verify-source.js src/renderer/js/collection-store.js src/renderer/js/i18n.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@vitest/ui": "^4.1.5",
    "electron": "github:castlabs/electron-releases#v42.5.2+wvcus",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.0",
    "@mlc-ai/web-llm": "^0.2.84",
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "tar": "^7.5.22",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "com.vex.browser",
    "productName": "Vex",
    "copyright": "Copyright 2026 0xmortuex",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "afterSign": "scripts/vmp-sign.js",
    "electronDownload": {
      "version": "42.5.2+wvcus",
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "CHANGELOG.md",
      "assets/icon.svg",
      "assets/icon.ico",
      "assets/theme-previews/*.png",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Document",
        "description": "HTML Document",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTML Document",
        "description": "HTML Document",
        "role": "Viewer"
      }
    ],
    "protocols": [
      {
        "name": "Web URL",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Vex-Setup.${ext}",
      "signtoolOptions": {
        "publisherName": "0xmortuex"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vex",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "differentialPackage": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "0xmortuex",
        "repo": "Vex",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "build/release-notes.md"
    }
  }
}
