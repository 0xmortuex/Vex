  "private": true,
  "description": "Vex for Android — the Vex browser as a native Android shell (Capacitor + system WebView)",
  "license": "MIT",
  "author": {
    "name": "0xmortuex",
    "email": "fraad002@gmail.com"
  },
  "scripts": {
    "sync": "cap sync android",
    "copy": "cap copy android",
