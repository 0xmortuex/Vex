<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's own surface. A widget cannot read the chrome's theme, so it
     wears Vex's default paper and hairline instead of guessing. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/vex_cream" />
    <stroke android:width="1dp" android:color="#22000000" />
    <corners android:radius="26dp" />
</shape>
