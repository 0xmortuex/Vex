<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's own surface: Vex's paper by day, Midnight's by night, chosen
     by the launcher's configuration rather than by the chrome. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <stroke android:width="1dp" android:color="@color/widget_stroke" />
    <corners android:radius="26dp" />
</shape>
